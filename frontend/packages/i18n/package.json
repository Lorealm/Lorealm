{
	"name": "@lorealm/i18n",
	"version": "0.1.0",
	"description": "Interface translations for Lorealm.",
	"private": true,
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"generate": "bun scripts/i18n.ts generate",
		"check": "bun scripts/i18n.ts check && tsc --noEmit && tsc --noEmit -p scripts"
	},
	"devDependencies": {
		"@formatjs/icu-messageformat-parser": "^2.11.4",
		"@types/bun": "^1.3.14",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"intl-messageformat": "^10.7.18"
	}
}
