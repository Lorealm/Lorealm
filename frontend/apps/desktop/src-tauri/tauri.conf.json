{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorealm",
  "version": "0.2.0",
  "identifier": "com.lorealm.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lorealm Desktop",
        "width": 1300,
        "height": 800,
        "label": "main",
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' blob:",
        "style-src": "'self' 'unsafe-inline' https:",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: https:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTYzREEwNDAyOTIxMTkKUldRWklTbEFvRDJtdkp4L0FVUTNWZGdtYzhqRU45WnhwbC93ZVM5akhBSU1ka1VZTVBoNi82RVYK",
      "endpoints": ["https://github.com/Lorealm/Lorealm/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
