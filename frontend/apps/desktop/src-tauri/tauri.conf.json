{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorealm",
  "version": "0.1.0",
  "identifier": "com.crux.lorealm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lorealm Desktop",
        "width": 1300,
        "height": 800,
        "label": "main",
  			"visible": false,
  			"decorations": true,
  			"titleBarStyle": "Overlay",
  			"hiddenTitle": true,
  			"trafficLightPosition": { "x": 18, "y": 16 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
