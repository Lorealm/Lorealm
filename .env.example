# Copy to .env (next to where you start the server) and fill in.

# Server secrets. Both are optional: when unset, they are generated on first
# start and saved to secrets.yaml in the data directory. Back that file up
# together with the database. Set these to keep secrets out of the data
# directory instead; a value set here always wins over the file.
#
# Encrypts the provider API keys stored in the database. Generate with:
#   openssl rand -hex 32
# To rotate, append a new key after a comma (oldest first, newest last):
#   LOREALM_MASTER_KEY=<old hex>,<new hex>
# LOREALM_MASTER_KEY=
#
# Keys the session and CSRF token hashes. Any long random string; changing it
# signs everyone out.
# LOREALM_SESSION_SECRET=

# Unattended first-time setup (e.g. Docker). When both are set, the first start
# creates this admin account instead of prompting, using Postgres if
# LOREALM_POSTGRES_URL is set and SQLite otherwise. Ignored once set up.
# LOREALM_ADMIN_USERNAME=
# LOREALM_ADMIN_PASSWORD=

# Path to the server config file. Created with defaults on first run.
# CONFIG_PATH=config.yaml

# Log filter, e.g. info, debug, or lorealm_server=debug,info
# RUST_LOG=info

# Postgres connection string, used when a Postgres backend in config.yaml
# has no connection_string of its own.
# LOREALM_POSTGRES_URL=postgresql://user:password@localhost/lorealm

# Default Redis URL offered by the server setup preset.
# LOREALM_REDIS_URL=redis://localhost:6379
