# Environment files
.env
.env.local
.env.*.local

# Backend
/backend/target/
/backend/**/*.rs.bk
/backend/*.pdb

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/*.local

# User data
/data/users/*
!/data/users/.gitkeep
## Make sure data folders created from default config values don't get tracked
/backend/data
/backend/config.yaml
/backend/server/data
/backend/server/config.yaml

# IDE
.idea/
.claude/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Docker
.dockerignore.local
